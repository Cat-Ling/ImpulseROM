From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ImpulseROM <noreply@localhost>
Subject: [PATCH] KnoxPatch: hide the SAK keystore type from Samsung Health, FMM and TV Plus

Small port of the SamsungPropsHooks idea from KnoxPatch (Salvo Giangreco, Ocin4ever) without a new
class: these apps stop asking for SAK attestation, which a custom kernel can never pass. Every
other process still reads the real ro.security.keystore.keytype.
---

--- a/smali_classes3/android/os/SystemProperties.smali
+++ b/smali_classes3/android/os/SystemProperties.smali
@@ -372,11 +372,72 @@
     return-object p0
 .end method
 
+.method private static hidesKeystoreType(Ljava/lang/String;)Z
+    .locals 2
+
+    const-string v0, "ro.security.keystore.keytype"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_no
+
+    invoke-static {}, Landroid/app/ActivityThread;->currentPackageName()Ljava/lang/String;
+
+    move-result-object p0
+
+    const-string v0, "com.sec.android.app.shealth"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_yes
+
+    const-string v0, "com.samsung.android.fmm"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_yes
+
+    const-string v0, "com.samsung.android.tvplus"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-nez v1, :cond_yes
+
+    :cond_no
+    const/4 p0, 0x0
+
+    return p0
+
+    :cond_yes
+    const/4 p0, 0x1
+
+    return p0
+.end method
+
 .method public static whitelist get(Ljava/lang/String;)Ljava/lang/String;
-    .locals 0
+    .locals 1
     .annotation runtime Landroid/annotation/SystemApi;
     .end annotation
 
+    invoke-static {p0}, Landroid/os/SystemProperties;->hidesKeystoreType(Ljava/lang/String;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_real
+
+    const-string p0, ""
+
+    return-object p0
+
+    :cond_real
     invoke-static {p0}, Landroid/os/SystemProperties;->native_get(Ljava/lang/String;)Ljava/lang/String;
 
     move-result-object p0
@@ -385,10 +446,21 @@
 .end method
 
 .method public static whitelist get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;
-    .locals 0
+    .locals 1
     .annotation runtime Landroid/annotation/SystemApi;
     .end annotation
 
+    invoke-static {p0}, Landroid/os/SystemProperties;->hidesKeystoreType(Ljava/lang/String;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_real
+
+    const-string p0, ""
+
+    return-object p0
+
+    :cond_real
     invoke-static {p0, p1}, Landroid/os/SystemProperties;->native_get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;
 
     move-result-object p0
