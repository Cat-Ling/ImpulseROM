From: ImpulseROM <noreply@localhost>
Subject: [PATCH] Keep screen resolution selector, fix UI calculation and initial selection

The S24 FE build folds the multi-resolution check in ScreenResolutionFragment.onCreate()
to an unconditional removePreference("screen_resolution_seekbar"), so the page opens
empty. Keep the selector on QHD devices.

Additionally:
- Always compute subtitles directly from initial physical panel size (HD=w/2, FHD=w*3/4,
  WQHD=w) so resolution labels do not incorrectly multiply by 2 or 4/3 when current mode
  is HD or FHD (preventing oversized resolution strings like 6080x2880).
- Initialize SecHorizontalRadioPreference.setValue() with the current screen resolution so
  the active resolution is pre-selected and highlighted upon opening the settings page.
- Initialize the help text view to match the current resolution.
---
diff --git a/smali_classes5/com/samsung/android/settings/display/ScreenResolutionFragment.smali b/smali_classes5/com/samsung/android/settings/display/ScreenResolutionFragment.smali
index c307403..e6680dc 100644
--- a/smali_classes5/com/samsung/android/settings/display/ScreenResolutionFragment.smali
+++ b/smali_classes5/com/samsung/android/settings/display/ScreenResolutionFragment.smali
@@ -384,8 +384,6 @@
 
     sget-object v1, Lcom/samsung/android/settings/Rune;->COMMON_CONFIG_PACKAGE_NAME_SMART_MANAGER:Ljava/lang/String;
 
-    invoke-virtual {p0, p1}, Lcom/android/settings/SettingsPreferenceFragment;->removePreference(Ljava/lang/String;)Z
-
     new-instance p1, Landroid/graphics/Point;
 
     invoke-direct {p1}, Landroid/graphics/Point;-><init>()V
@@ -584,10 +582,12 @@
     move v2, p1
 
     :goto_3
-    iget p1, p0, Lcom/samsung/android/settings/display/ScreenResolutionFragment;->mScreenResolution:I
-
     const/4 v3, 0x2
 
+    goto :cond_5
+
+    iget p1, p0, Lcom/samsung/android/settings/display/ScreenResolutionFragment;->mScreenResolution:I
+
     if-eq p1, v1, :cond_6
 
     if-eq p1, v3, :cond_5
@@ -765,6 +765,14 @@
 
     invoke-virtual {p1, v0}, Landroidx/preference/Preference;->seslSetRoundedBg(I)V
 
+    iget v0, p0, Lcom/samsung/android/settings/display/ScreenResolutionFragment;->mScreenResolution:I
+
+    invoke-static {v0}, Ljava/lang/Integer;->toString(I)Ljava/lang/String;
+
+    move-result-object v0
+
+    invoke-virtual {p1, v0}, Lcom/samsung/android/settings/widget/SecHorizontalRadioPreference;->setValue(Ljava/lang/String;)V
+
     new-instance p1, Lcom/samsung/android/settings/widget/SecButtonPreference;
 
     iget-object v0, p0, Lcom/samsung/android/settings/display/ScreenResolutionFragment;->mContext:Landroid/content/Context;
@@ -843,6 +851,25 @@
 
     invoke-virtual {v0, v1}, Landroidx/preference/Preference;->setOnPreferenceChangeListener(Landroidx/preference/Preference$OnPreferenceChangeListener;)V
 
+    iget v0, p0, Lcom/samsung/android/settings/display/ScreenResolutionFragment;->mScreenResolution:I
+
+    const v1, 0x7f1522f3
+
+    const/4 v2, 0x2
+
+    if-eq v0, v2, :cond_res_init
+
+    const/4 v2, 0x1
+
+    const v1, 0x7f1522e6
+
+    if-eq v0, v2, :cond_res_init
+
+    const v1, 0x7f1522ea
+
+    :cond_res_init
+    invoke-virtual {p1, v1}, Landroid/widget/TextView;->setText(I)V
+
     invoke-virtual {p0}, Lcom/samsung/android/settings/display/ScreenResolutionFragment;->setPreview$1()V
 
     return-void

