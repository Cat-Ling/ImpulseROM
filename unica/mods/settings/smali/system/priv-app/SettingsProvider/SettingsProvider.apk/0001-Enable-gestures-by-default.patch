From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ImpulseROM <noreply@localhost>
Subject: [PATCH] Enable gestures by default

SecUpgradeController.initDisplaySettings(): treat every model as gesture-default and set
navigationbar_splugin_flags=4 (no simplified gesture). Rebased onto One UI 8.5 DZF3.
---
 smali/com/android/providers/settings/SecUpgradeController.smali | changed
 1 file changed

--- a/smali/com/android/providers/settings/SecUpgradeController.smali
+++ b/smali/com/android/providers/settings/SecUpgradeController.smali
@@ -4503,7 +4503,7 @@
 
     move-result p0
 
-    const/4 v0, 0x0
+    const/4 v0, 0x1
 
     if-eqz p0, :cond_b
 
@@ -4623,6 +4623,14 @@
     const-string v5, "navigation_bar_back_gesture_sensitivity_sub"
 
     const-string v6, "1"
+
+    invoke-virtual/range {v4 .. v9}, Lcom/android/providers/settings/SettingsState;->insertSettingLocked(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;ZLjava/lang/String;)Z
+
+    const-string v9, "android"
+
+    const-string v5, "navigationbar_splugin_flags"
+
+    const-string v6, "4"
 
     invoke-virtual/range {v4 .. v9}, Lcom/android/providers/settings/SettingsState;->insertSettingLocked(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;ZLjava/lang/String;)Z
 
-- 
2.43.0

