Subject: [PATCH] Enable gestures by default

NavigationBarSettingsUtil.isGestureDefault() returns true (stock: China models only).
Rebased onto One UI 8.5 DZF3.
---
 smali_classes5/com/samsung/android/settings/navigationbar/NavigationBarSettingsUtil.smali | changed
 1 file changed

--- a/smali_classes5/com/samsung/android/settings/navigationbar/NavigationBarSettingsUtil.smali
+++ b/smali_classes5/com/samsung/android/settings/navigationbar/NavigationBarSettingsUtil.smali
@@ -119,32 +119,11 @@
 .end method
 
 .method public static isGestureDefault()Z
-    .locals 3
-
-    const-string/jumbo v0, "ro.product.first_api_level"
-
-    const/4 v1, 0x0
-
-    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getInt(Ljava/lang/String;I)I
-
-    move-result v0
-
-    invoke-static {}, Lcom/samsung/android/settings/Rune;->isChinaModel()Z
-
-    move-result v2
-
-    if-eqz v2, :cond_0
-
-    const/16 v2, 0x23
-
-    if-lt v0, v2, :cond_0
+    .locals 1
 
     const/4 v0, 0x1
 
     return v0
-
-    :cond_0
-    return v1
 .end method
 
 .method public static isGestureHintOn(Landroid/content/Context;)Z
