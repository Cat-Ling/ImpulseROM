From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ImpulseROM <noreply@localhost>
Subject: [PATCH] Allow app downgrade

isDowngradePermitted() always returns true, so adb install -d / downgrade installs of
non-debuggable apps are accepted. Rebased onto One UI 8.5 DZF3.
---
 smali_classes2/com/android/server/pm/PackageManagerServiceUtils.smali | changed
 1 file changed

--- a/smali_classes2/com/android/server/pm/PackageManagerServiceUtils.smali
+++ b/smali_classes2/com/android/server/pm/PackageManagerServiceUtils.smali
@@ -2333,42 +2333,11 @@
 .end method
 
 .method public static isDowngradePermitted(IZ)Z
-    .locals 3
-
-    and-int/lit16 v0, p0, 0x80
-
-    const/4 v1, 0x0
-
-    if-eqz v0, :cond_3
-
-    sget-boolean v0, Landroid/os/Build;->IS_DEBUGGABLE:Z
-
-    const/4 v2, 0x1
-
-    if-nez v0, :cond_2
-
-    if-eqz p1, :cond_0
-
-    goto :goto_0
-
-    :cond_0
-    const/high16 p1, 0x100000
-
-    and-int/2addr p0, p1
-
-    if-eqz p0, :cond_1
-
-    return v2
-
-    :cond_1
-    return v1
-
-    :cond_2
-    :goto_0
-    return v2
-
-    :cond_3
-    return v1
+    .locals 1
+
+    const/4 v0, 0x1
+
+    return v0
 .end method
 
 .method public static isInstalledByAdb(Ljava/lang/String;)Z
-- 
